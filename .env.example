# 이 파일을 복사해서 프로젝트 루트에 .env 로 저장하고 값을 채우세요.
#
#   cp .env.example .env
#
# .env 는 절대 커밋하지 마세요 (.gitignore 에 등록되어 있습니다).


# ── 관광 Open API ────────────────────────────────
# 공공데이터포털 인증키. Encoding/Decoding 아무거나 넣어도 자동 처리됩니다.
# 서버·배치 전용입니다. 앱 빌드에는 들어가지 않습니다.
TOUR_API_KEY=


# ── Supabase ─────────────────────────────────────
SUPABASE_URL=

# service_role(또는 Secret) 키.
# 배치(pipeline)와 백엔드만 사용합니다. RLS 를 우회하는 관리자 키이므로
# 앱이나 --dart-define 에 절대 넣지 마세요.
SUPABASE_SERVICE_KEY=

# anon(또는 Publishable) 키.
# 앱에 포함되는 공개 키입니다. places 는 읽기만, reports 는 쓰기만
# 허용되어 있어 노출되어도 데이터를 훼손할 수 없습니다.
SUPABASE_PUBLISHABLE_KEY=


# ── 지도 ─────────────────────────────────────────
# 네이버 클라우드 Client ID (X-NCP-APIGW-API-KEY-ID).
# Client Secret 은 넣지 마세요. 웹 지도 SDK 에는 필요 없고,
# 빌드 산출물에 노출됩니다.
#
# 콘솔의 Web 서비스 URL 에 아래를 등록해야 지도가 뜹니다:
#   http://localhost:8080   (run_web.sh 가 이 포트를 고정합니다)
#   https://실제-배포-주소
NAVER_MAP_CLIENT_ID=


# ── 실시간 상세조회 백엔드 ───────────────────────
# 장소 상세에 들어갈 때 관광 Open API 를 다시 호출하는 서버 주소.
# 끝에 슬래시를 붙이지 마세요.
#
# 비워두면 실시간 조회를 건너뛰고 Supabase 에서 읽은 데이터를 씁니다.
# 화면과 기능은 동일하게 동작합니다.
PETPASS_API_BASE_URL=
